-- [[ 7. AUTO SKILL ]]
-- ================================================
local gearRemotes  = nil
local gearPurchase = nil

task.spawn(function()
    local ok, gr = pcall(function()
        return ReplicatedStorage:WaitForChild("GearRemotes", 15)
    end)
    if ok and gr then
        gearRemotes  = gr
        gearPurchase = gr:FindFirstChild("GearPurchase")
    end
end)

local slotKeys = { [1]=Enum.KeyCode.E, [2]=Enum.KeyCode.R, [3]=Enum.KeyCode.Q }

task.spawn(function()
    while true do
        task.wait(0.2)
        if UserInputService:GetFocusedTextBox() then continue end

        for i = 1, 3 do
            if not Toggles.AutoSkill[i] then continue end

            local fired = false

            -- Metode 1: GearPurchase remote (cara resmi game)
            if gearPurchase then
                pcall(function()
                    local gb       = _G.GearButtons
                    local slotData = gb and gb["Slot"..i]
                    local gearName = slotData and slotData.GearName
                    if gearName and gearName ~= "" then
                        gearPurchase:FireServer(gearName)
                        fired = true
                    end
                end)
            end

            -- Metode 2: GearClient
            if not fired then
                pcall(function()
                    local gc = _G.GearClient
                    if gc and gc.OnGearSlotPressed then
                        gc:OnGearSlotPressed(i)
                        fired = true
                    end
                end)
            end

            -- Metode 3: VIM keypress fallback
            if not fired then
                pcall(function()
                    VIM:SendKeyEvent(true,  slotKeys[i], false, game)
                    task.wait(0.03)
                    VIM:SendKeyEvent(false, slotKeys[i], false, game)
                end)
            end
        end
    end
end)

