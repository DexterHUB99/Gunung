-- ================================================
-- AUTO JUMP (VIM Space setiap 10 detik)
-- ================================================
task.spawn(function()
    while true do
        task.wait(10)
        if not Toggles.AutoJump then continue end

        -- Metode 1: Humanoid.Jump langsung
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Jump = true
        end

        -- Metode 2: VIM kirim Space sebagai fallback
        pcall(function()
            VIM:SendKeyEvent(true,  Enum.KeyCode.Space, false, game)
            task.wait(0.1)
            VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end
end)

-- ================================================
-- AUTO UPGRADE HP + SENJATA
-- ================================================
local remoteCache = {}
local function GetRemote(folder, name)
    local key = folder.."."..name
    if remoteCache[key] then return remoteCache[key] end
    local f = ReplicatedStorage:FindFirstChild(folder)
    if not f then return nil end
    local r = f:FindFirstChild(name)
    if r then remoteCache[key] = r end
    return r
end

task.spawn(function()
    while true do
        task.wait(0.18)

        if Toggles.AutoHealth then
            pcall(function()
                local r = GetRemote("UpgradeRemotes", "PurchaseHealthUpgrade")
                if r then r:FireServer() end
            end)
        end

        if Toggles.AutoWeapon then
            pcall(function()
                local r = GetRemote("UpgradeRemotes", "PurchaseWeaponUpgrade")
                if r then r:FireServer() end
            end)
        end
    end
end)

-- Auto equip senjata baru masuk backpack
local function WatchBackpack()
    local bp = LocalPlayer:WaitForChild("Backpack", 10)
    if not bp then return end
    bp.ChildAdded:Connect(function(child)
        if not Toggles.AutoWeapon then return end
        if not child:IsA("Tool") then return end
        task.wait(0.2)
        -- Equip via VIM angka 1
        pcall(function()
            VIM:SendKeyEvent(true,  Enum.KeyCode.One, false, game)
            task.wait(0.06)
            VIM:SendKeyEvent(false, Enum.KeyCode.One, false, game)
        end)
        -- Fallback langsung pindah tool
        pcall(function()
            local char = LocalPlayer.Character
            if bp and char then
                local tool = bp:FindFirstChildOfClass("Tool")
                if tool then tool.Parent = char end
            end
        end)
    end)
end

task.spawn(WatchBackpack)
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    WatchBackpack()
end)

