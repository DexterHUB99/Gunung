-- ================================================
-- STATE TEMBAKAN — dikelola satu tempat
-- ================================================
local isFiring      = false   -- apakah mouse1press sedang aktif
local shootPaused   = false   -- true = sedang pause karena equip senjata

-- Fungsi terpusat untuk lepas tembakan
local function ReleaseShot()
    if isFiring then
        isFiring = false
        pcall(function()
            if mouse1release then mouse1release() end
        end)
        -- Fallback VIM release
        pcall(function()
            VIM:SendMouseButtonEvent(
                Camera.ViewportSize.X / 2,
                Camera.ViewportSize.Y / 2,
                0, false, game, 1
            )
        end)
    end
end

-- Fungsi terpusat untuk mulai tembakan
local function StartShot()
    if not isFiring then
        isFiring = true
        pcall(function()
            if mouse1press then
                mouse1press()
            else
                VIM:SendMouseButtonEvent(
                    Camera.ViewportSize.X / 2,
                    Camera.ViewportSize.Y / 2,
                    0, true, game, 1
                )
            end
        end)
    end
end

