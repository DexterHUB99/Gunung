-- [[ 8. AUTO UPGRADE + AUTO EQUIP + RESUME SHOOT ]]
-- ================================================
local remoteCache = {}
local function GetRemote(folder, name)
    local key = folder.."."..name
    if remoteCache[key] then return remoteCache[key] end
    local f = ReplicatedStorage:FindFirstChild(folder)
    if not f then return nil end
    local r = f:FindFirstChild(name)
    if r then remoteCache[key] = r end
    return r
end

-- Auto equip + resume tembakan
-- Urutan:
--   1. Pause auto shoot (release dulu)
--   2. Tunggu senjata masuk backpack
--   3. Equip senjata (tekan 1)
--   4. Tunggu game register equip (0.3s)
--   5. Resume auto shoot (press lagi otomatis)
local function EquipNewWeaponAndResume()
    shootPaused = true   -- hentikan hold sementara
    ReleaseShot()        -- pastikan mouse1 dilepas

    task.wait(0.2)       -- tunggu tool masuk backpack

    -- Equip via VIM tekan angka 1
    pcall(function()
        VIM:SendKeyEvent(true,  Enum.KeyCode.One, false, game)
        task.wait(0.06)
        VIM:SendKeyEvent(false, Enum.KeyCode.One, false, game)
    end)

    -- Fallback: langsung pindah tool ke character
    pcall(function()
        local bp   = LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character
        if bp and char then
            local tool = bp:FindFirstChildOfClass("Tool")
            if tool then tool.Parent = char end
        end
    end)

    task.wait(0.35)      -- tunggu equip selesai diproses game

    shootPaused = false  -- izinkan hold loop mulai lagi
    -- Loop di Bagian B akan otomatis panggil StartShot() di iterasi berikutnya
end

local function WatchBackpack()
    local bp = LocalPlayer:WaitForChild("Backpack", 10)
    if not bp then return end

    bp.ChildAdded:Connect(function(child)
        if not Toggles.AutoWeapon then return end
        if not child:IsA("Tool") then return end
        EquipNewWeaponAndResume()
    end)
end

task.spawn(WatchBackpack)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    WatchBackpack()
end)

