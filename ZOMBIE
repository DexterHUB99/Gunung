-- Bagian A: Aimbot di RenderStepped
RunService.RenderStepped:Connect(function()
    if not Toggles.AutoShoot then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        return
    end

    local target = GetNearestZombie()
    if target then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)

        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.lookAt(
                    hrp.Position,
                    Vector3.new(target.Position.X, hrp.Position.Y, target.Position.Z)
                )
            end
        end
    else
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end)

-- Bagian B: Hold loop di thread terpisah
task.spawn(function()
    while true do
        task.wait(0.05)

        -- Auto Shoot dimatikan
        if not Toggles.AutoShoot then
            ReleaseShot()
            continue
        end

        -- Sedang pause karena weapon equip — tunggu sampai selesai
        if shootPaused then
            ReleaseShot()
            continue
        end

        local target = GetNearestZombie()
        if target then
            StartShot()
        else
            ReleaseShot()
        end
    end
end)

