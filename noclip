local function MakeButton(label, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size             = UDim2.new(0.95, 0, 0, 38)
    Btn.BackgroundColor3 = Color3.fromRGB(38, 38, 55)
    Btn.Text             = label .. ": OFF"
    Btn.TextColor3       = Color3.fromRGB(180, 180, 180)
    Btn.Font             = Enum.Font.GothamSemibold
    Btn.TextSize         = 12
    Btn.Parent           = ScrollFrame
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 7)

    local active = false
    Btn.MouseButton1Click:Connect(function()
        active = not active
        Btn.Text             = label .. (active and ": ON" or ": OFF")
        Btn.TextColor3       = active and Color3.fromRGB(100, 255, 130) or Color3.fromRGB(180, 180, 180)
        Btn.BackgroundColor3 = active and Color3.fromRGB(28, 55, 32)   or Color3.fromRGB(38, 38, 55)
        callback(active)
    end)
    return Btn
end

local function MakeLabel(txt)
    local L = Instance.new("TextLabel")
    L.Size               = UDim2.new(0.95, 0, 0, 20)
    L.BackgroundTransparency = 1
    L.Text               = txt
    L.TextColor3         = Color3.fromRGB(100, 100, 135)
    L.Font               = Enum.Font.GothamBold
    L.TextSize           = 10
    L.TextXAlignment     = Enum.TextXAlignment.Left
    L.Parent             = ScrollFrame
    return L
end

-- ================================================
-- FLY
-- ================================================
local flyActive = false
local bg, bv

local function ToggleFly(state)
    flyActive = state
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if flyActive then
        bg = Instance.new("BodyGyro", hrp)
        bg.P = 9e4; bg.maxTorque = Vector3.new(9e9,9e9,9e9)
        bg.cframe = hrp.CFrame

        bv = Instance.new("BodyVelocity", hrp)
        bv.velocity = Vector3.zero
        bv.maxForce = Vector3.new(9e9,9e9,9e9)

        task.spawn(function()
            while flyActive and hrp and hrp.Parent do
                local dir = Vector3.zero
                local spd = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 110 or 55
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector  end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector  end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.E) then dir += Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.Q) then dir -= Vector3.new(0,1,0) end
                bg.cframe   = Camera.CFrame
                bv.velocity = dir * spd
                task.wait()
            end
        end)
    else
        if bg then bg:Destroy(); bg = nil end
        if bv then bv:Destroy(); bv = nil end
    end
end

